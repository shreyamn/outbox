# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=reachinbox_secret
POSTGRES_DB=reachinbox
DATABASE_URL=postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Elasticsearch ───────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_random_256bit_secret
JWT_EXPIRES_IN=7d

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ─── Slack OAuth ──────────────────────────────────────────────────────────────
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# ─── Ethereal SMTP (auto-created on first run) ────────────────────────────────
# Leave blank; the app will create a test account automatically
ETHEREAL_USER=
ETHEREAL_PASS=

# ─── Worker / Rate Limiting ───────────────────────────────────────────────────
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=100

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
